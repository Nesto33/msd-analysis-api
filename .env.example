PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=msd_user
DB_PASSWORD=msd_password
DB_DATABASE=msd_db

# false (recommandé, y compris en dev) : le schéma est géré par les migrations
# (src/migrations), appliquées automatiquement au démarrage de l'API.
# Ne passer à true que temporairement, en dev local, pour itérer vite sur une entité
# avant de générer la migration correspondante — jamais en déploiement.
DB_SYNCHRONIZE=false
