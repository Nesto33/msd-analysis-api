PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=msd_user
DB_PASSWORD=msd_password
DB_DATABASE=msd_db

# true : synchronise le schéma automatiquement depuis les entités (pratique en dev local).
# En déploiement (docker-compose), le défaut est false : le schéma est géré par les
# migrations (src/migrations), appliquées automatiquement au démarrage de l'API.
DB_SYNCHRONIZE=true
